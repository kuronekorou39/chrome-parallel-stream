{
  "manifest_version": 3,
  "name": "Parallel Stream",
  "version": "0.9.8",
  "description": "Twitch / YouTube / mellow-fan(旧OPENREC) / Kick の配信を1画面に並べて見るマルチビュー。枠ごとの音量・コメント弾幕つき。",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "cookies",
    "declarativeNetRequest",
    "system.cpu",
    "system.memory"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Parallel Stream",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://*.youtube.com/*",
        "*://*.openrec.tv/*",
        "*://*.mellow-fan.com/*"
      ],
      "js": [
        "stream-control.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://player.twitch.tv/*"
      ],
      "js": [
        "twitch-keepalive.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.twitch.tv/*",
        "*://*.openrec.tv/*",
        "*://*.mellow-fan.com/*"
      ],
      "js": [
        "keepalive-visibility.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://kuronekorou39.github.io/chrome-parallel-stream/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_streams",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
