{
  "manifest_version": 3,
  "name": "Parallel Stream Probe",
  "version": "0.1.0",
  "description": "Phase 1 capability probe: Android向け自作Chromiumブラウザでマルチビュー実現可能性を実機で検証する。",
  "permissions": [
    "tabs",
    "windows",
    "scripting",
    "activeTab",
    "storage",
    "sidePanel",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Parallel Stream Probe"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.twitch.tv/*",
        "*://*.youtube.com/*",
        "*://*.kick.com/*",
        "*://*.openrec.tv/*"
      ],
      "js": ["stream-control.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ruleset_streams", "enabled": true, "path": "rules.json" }
    ]
  }
}
